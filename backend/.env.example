# --- Core ---
# PostgreSQL is the production database. For local development you may use SQLite.
DATABASE_URL=postgresql+psycopg://trb:trb@localhost:5432/trb
# DATABASE_URL=sqlite:///./trb.db

# Secret used to sign access tokens. CHANGE THIS in production.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# --- Admin bootstrap ---
# The first admin account created by scripts/seed.py
ADMIN_EMAIL=admin@trb.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=TRB Administrator
ADMIN_COUNTRY=KE

# --- Verification ---
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_LOCK_MINUTES=15

# --- Market data provider ---
# Supported: none | yahoo | twelvedata | alphavantage | finnhub
# "yahoo" is keyless (public Yahoo Finance endpoint) and returns real data.
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_KEY=

# When true (and no provider is set) the API returns clearly-labelled SAMPLE
# data so the interface can be explored. Never presented as live data.
DEMO_MODE=true

# --- Chart screenshot analyzer (vision model) ---
# When VISION_PROVIDER and VISION_API_KEY are set, uploaded chart screenshots are
# analyzed by a vision-capable model. Recommended free option: Google Gemini via
# its OpenAI-compatible endpoint (VISION_PROVIDER=openai).
# Supported provider style: any OpenAI-compatible chat API (openai, gemini, etc.)
VISION_PROVIDER=none
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_BASE_URL=https://api.openai.com/v1

# --- Messaging ---
MESSAGE_RATE_LIMIT_PER_MINUTE=20

# --- WhatsApp integration (optional; disabled by default) ---
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER=
